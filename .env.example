# ════════════════════════════════════════════════════════════════════════
# MyZipVault — Environment Variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` (Next.js auto-loads it) and fill in real values.
# NEVER commit `.env.local` to git. The `.gitignore` already excludes it.
#
# For Vercel production, set these via Dashboard → Project → Settings →
# Environment Variables. Mark each as Production / Preview / Development.
# ════════════════════════════════════════════════════════════════════════

# ─── Database (Supabase Postgres) ──────────────────────────────────────
# Connection string with PgBouncer (port 6543). Use direct connection (port 5432)
# for Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres"

# For local scripts (scripts/check-db.js, scripts/bob-pre-migration-check.js)
# Use the DIRECT_URL above or set this separately.
SUPABASE_DB_URL=""

# ─── Supabase Storage (file uploads: credentials, VaultSign docs) ─────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_NAME="myzipvault"

# ─── NextAuth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Cron Auth (protects /api/cron/*) ─────────────────────────────────
# Generate with: openssl rand -hex 32
# Set this in cron-job.org as a custom header: x-cron-secret: <value>
CRON_SECRET=""

# ─── Encryption (AES-256-CBC for SSN + sensitive at-rest fields) ──────
# Generate with: openssl rand -hex 32
# Required — throws at runtime if missing.
ENCRYPTION_KEY=""

# ─── Brevo (transactional email) ──────────────────────────────────────
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@myzipvault.com"
BREVO_SENDER_NAME="MyZipVault"
BREVO_WEBHOOK_SECRET=""

# ─── Stripe (billing — only needed if using Stripe for credit purchases)
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CREDIT_PRICE_ID=""

# ─── Twilio (SMS notifications — FeatureFlag-gated, off by default) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Affinda (resume parsing) ──────────────────────────────────────────
AFFINDA_API_KEY=""

# ─── AI Providers (3-provider fallback chain — only fill the ones you use)
# Groq is the cheapest, used by src/lib/ai-unified.ts
GROQ_API_KEY=""
# Google Gemini (used by src/lib/gemini.ts)
GEMINI_API_KEY=""
# Z.AI (used by src/lib/zai.ts) — default free tier
ZAI_API_KEY=""

# ─── App URL (used in email templates + public links) ─────────────────
# Override NEXTAUTH_URL when deploying to a custom domain.
APP_URL="https://myzipvault.com"

# ─── Optional: Error Alert Recipients (cron errors get emailed here) ──
ERROR_ALERT_EMAIL="ops@myzipvault.com"

# ─── Optional: OAuth providers (currently NOT enabled in code) ────────
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
