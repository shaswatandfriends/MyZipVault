generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 1. Organizations ────────────────────────────────────────────────
model Organization {
  id                  Int                  @id @default(autoincrement())
  public_id           String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — prevents enumeration of agency IDs in URLs.
    // Internal joins still use INT id; this is for public APIs only.
  name                String
  credits_balance     Int                  @default(0)
  baa_status          String               @default("pending")
  baa_document_url    String?
  baa_signed_by_name  String?
  baa_signed_by_title String?
  baa_signed_at       DateTime?
  seat_limit          Int                  @default(5)
  custom_pricing_notes String?
  account_status      String               @default("pending")
  created_at          DateTime             @default(now())

  // VaultSign document settings
  company_logo_url    String?              // Logo for document headers
  company_address     String?              // Address for document headers/footers
  company_phone       String?              // Phone for document headers
  company_email       String?              // Email for document headers
  company_website     String?              // Website for document headers

  // Org settings (Phase 3 — added 2026-06-21)
  date_format              String?  @default("MM/DD/YYYY") // mm/dd/yyyy | dd/mm/yyyy | yyyy-mm-dd
  show_billing_to_recruiters Boolean @default(false) // Admin toggle — show Billing in recruiter sidebar
  allow_credit_requests    Boolean  @default(false) // Admin toggle — recruiters can request more credits
  allow_recruiter_csv_export Boolean @default(true)  // Admin toggle — recruiters can export BOB CSV

  // Checklist request settings (per-company, set by superadmin)
  pending_request_expiry_days Int @default(7)  // how many days a pending checklist request lives before auto-expiring

  users               User[]
  credit_transactions CreditTransaction[]
  invoices            Invoice[]
  invite_tokens       InviteToken[]
  recruiter_leads     RecruiterLead[]
  vault_sign_documents VaultSignDocument[]
  compliance_bundles   ComplianceBundle[]
  candidate_pools      CandidatePool[]

  // ─── Marketplace relations (Phase 0 — added 2026-08-15) ────────────
  job_postings_posted             JobPosting[]               @relation("JobPostingOrganization")
  candidate_submissions           CandidateSubmission[]      @relation("SubmissionOrganization")
  ownership_windows               CandidateOwnershipWindow[] @relation("OwnershipWindowOrganization")
  contact_reveals                 CandidateContactReveal[]   @relation("ContactRevealOrganization")
}

// ─── 2. Users ────────────────────────────────────────────────────────
model User {
  id                   Int                   @id @default(autoincrement())
  public_id            String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — prevents enumeration of user IDs in URLs.
    // Internal joins still use INT id; this is for public APIs only.
  email                String                @unique
  password_hash        String
  role                 String
  organization_id      Int?
  must_change_pass     Boolean               @default(false)
  tos_accepted_at      DateTime?
  account_status       String                @default("active")
  deletion_requested_at DateTime?
  is_approved          Boolean               @default(true)
  first_name           String?
  last_name            String?
  email_verified_at    DateTime?
  phone                String?
  last_activity_at     DateTime?
  created_at           DateTime              @default(now())

  organization         Organization?         @relation(fields: [organization_id], references: [id])

  admin_permissions    AdminPermission[]
  candidate_profile    CandidateProfile?
  checklist_requests_as_client   ChecklistRequest[]   @relation("ClientChecklistRequests")
  checklist_requests_as_candidate ChecklistRequest[]   @relation("CandidateChecklistRequests")
  credentials          Credential[]
  credentials_reviewed Credential[]          @relation("CredentialReviewer")
  resumes              Resume[]
  candidate_references CandidateReference[]
  candidate_references_manager CandidateReference[]  @relation("ReferenceManager")
  consent_shares_as_candidate ConsentShare[]  @relation("CandidateConsentShares")
  consent_shares_as_client   ConsentShare[]  @relation("ClientConsentShares")
  unlocked_documents   UnlockedDocument[]
  notifications        Notification[]
  audit_logs           AuditLog[]
  pending_reminders_target  PendingReminder[] @relation("ReminderTarget")
  pending_reminders_actioned PendingReminder[] @relation("ReminderActioner")
  platform_settings_updated PlatformSetting[]
  feature_flags_updated FeatureFlag[]
  email_templates_updated EmailTemplate[]
  candidate_checklist_responses CandidateChecklistResponse[]
  document_flags_reviewed  DocumentFlag[]     @relation("DocumentFlagReviewer")
  invite_tokens           InviteToken[]
  api_keys_updated       ApiKey[]
  share_requests_as_candidate ShareRequest[]  @relation("CandidateShareRequests")
  share_requests_as_client   ShareRequest[]  @relation("ClientShareRequests")

  // Calendar & Scheduler relations
  calendar_availabilities     CalendarAvailability[]
  calendar_shares_as_candidate CalendarShare[]  @relation("CandidateCalendarShares")
  calendar_shares_as_recruiter CalendarShare[]  @relation("RecruiterCalendarShares")
  recruiter_leads             RecruiterLead[]
  recruiter_availability      RecruiterAvailability[]
  shift_requests_as_candidate ShiftRequest[]   @relation("CandidateShiftRequests")
  shift_requests_as_recruiter ShiftRequest[]   @relation("RecruiterShiftRequests")
  call_schedules         CallSchedule[]
  call_logs              CallLog[]
  reference_deletion_requests ReferenceDeletionRequest[] @relation("CandidateDeletionRequests")
  reference_deletion_reviewed ReferenceDeletionRequest[] @relation("AdminDeletionReviews")

  // VaultSign relations
  vault_sign_templates_created VaultSignTemplate[] @relation("VaultSignTemplateCreator")
  vault_sign_documents_created VaultSignDocument[] @relation("VaultSignDocumentCreator")
  vault_sign_signers VaultSignSigner[] @relation("VaultSignSignerUser")

  // Banner relations
  banners_created Banner[]

  // Email Campaign relations
  email_campaigns_created         EmailCampaign[]          @relation("EmailCampaignCreator")
  email_campaign_recipients       EmailCampaignRecipient[] @relation("EmailCampaignRecipientUser")

  // Compliance Bundle relations
  compliance_bundles_created      ComplianceBundle[]       @relation("ComplianceBundleCreator")

  // Candidate Pool relations
  candidate_pools                 CandidatePool[]          @relation("CandidatePoolRecruiter")
  pool_memberships                CandidatePoolMember[]    @relation("CandidatePoolCandidate")

  // BOB (Book of Business) relations — Phase 1 (added 2026-06-20)
  recruiter_leads_as_candidate    RecruiterLead[]          @relation("RecruiterLeadCandidate")
  recruiter_leads_blacklisted_by  RecruiterLead[]          @relation("RecruiterLeadBlacklistedBy")
  lead_activities                 RecruiterLeadActivity[]  @relation("RecruiterLeadActivityActor")

  // ─── Marketplace relations (Phase 0 — added 2026-08-15) ────────────
  // CandidateRecord ownership (recruiter who brought the candidate via Path B)
  candidate_records_owned         CandidateRecord[]        @relation("CandidateRecordOwner")
  // CandidateRecord self-claim (when a candidate signs up using matching email)
  candidate_records_claimed       CandidateRecord[]        @relation("CandidateRecordClaimedBy")
  // Contact info provenance
  candidate_contact_info_added    CandidateContactInfo[]   @relation("ContactInfoAddedByRecruiter")
  // Job postings (superadmin/platform posts)
  job_postings_posted             JobPosting[]             @relation("JobPostingPoster")
  // Candidate submissions (recruiter submits candidate → job)
  candidate_submissions           CandidateSubmission[]   @relation("SubmissionRecruiter")
  // Ownership windows
  ownership_windows               CandidateOwnershipWindow[] @relation("OwnershipWindowRecruiter")
  // Contact reveals (credit-gated)
  contact_reveals                 CandidateContactReveal[] @relation("ContactRevealRecruiter")
  // Reputation (the recruiter being reviewed)
  recruiter_reviews_received      RecruiterReview[]         @relation("RecruiterReviewsReceived")
  // Reputation (the reviewer)
  recruiter_reviews_given         RecruiterReview[]         @relation("RecruiterReviewsGiven")
  // Reputation score (aggregate)
  reputation_score                RecruiterReputationScore?
  // Reports filed against this recruiter
  recruiter_reports_received      RecruiterReport[]         @relation("RecruiterReportsReceived")
  // Reports filed by this user
  recruiter_reports_filed         RecruiterReport[]         @relation("RecruiterReportsFiled")
  // Review disputes filed by this recruiter
  review_disputes_filed           RecruiterReviewDispute[]  @relation("ReviewDisputeRecruiter")
  // Reports handled by this admin
  recruiter_reports_handled       RecruiterReport[]         @relation("RecruiterReportsHandled")
  // Disputes handled by this admin
  review_disputes_handled         RecruiterReviewDispute[]  @relation("ReviewDisputeHandled")
}

// ─── 3. Admin Permissions ────────────────────────────────────────────
model AdminPermission {
  id              Int      @id @default(autoincrement())
  user_id         Int
  permission_name String
  is_allowed      Boolean  @default(false)

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_name])
}

// ─── 4. Candidate Profiles ──────────────────────────────────────────
model CandidateProfile {
  id                     Int       @id @default(autoincrement())
  user_id                Int       @unique
  first_name             String
  last_name              String
  phone                  String
  resume_id              Int?      @unique
  profile_completion_pct Int       @default(0)
  notification_preferences String? // JSON string: { email_notifications, sms_notifications, reminder_notifications }

  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  resume                 Resume?   @relation("CandidateProfileResume", fields: [resume_id], references: [id])
}

// ─── 5. Checklist Templates ─────────────────────────────────────────
model ChecklistTemplate {
  id            Int                        @id @default(autoincrement())
  profession    String
  specialty     String
  name          String
  job_title     String?
  is_active     Boolean                    @default(true)
  created_at    DateTime                   @default(now())

  skills        Skill[]
  checklist_requests ChecklistRequest[]
  candidate_checklist_responses CandidateChecklistResponse[]
  compliance_bundles  ComplianceBundle[]
}

// ─── 6. Skills ───────────────────────────────────────────────────────
model Skill {
  id                    Int               @id @default(autoincrement())
  checklist_template_id Int
  skill_name            String
  category              String
  question_type         String
  sort_order            Int
  has_na_option         Boolean           @default(true)

  checklist_template    ChecklistTemplate @relation(fields: [checklist_template_id], references: [id], onDelete: Cascade)
  skill_ratings         SkillRating[]
}

// ─── 7. Checklist Requests ──────────────────────────────────────────
model ChecklistRequest {
  id                     Int                    @id @default(autoincrement())
  client_user_id         Int
  candidate_user_id      Int
  checklist_template_id  Int
  status                 String                 @default("sent")
  completion_pct         Int                    @default(0)
  candidate_response_id  Int?
  opened_at              DateTime?
  created_at             DateTime               @default(now())
  expires_at             DateTime?              // null = no expiry; set to now + org.pending_request_expiry_days on creation

  client_user            User                   @relation("ClientChecklistRequests", fields: [client_user_id], references: [id])
  candidate_user         User                   @relation("CandidateChecklistRequests", fields: [candidate_user_id], references: [id])
  checklist_template     ChecklistTemplate      @relation(fields: [checklist_template_id], references: [id])
  candidate_response     CandidateChecklistResponse? @relation(fields: [candidate_response_id], references: [id])
}

// ─── 8. Candidate Checklist Responses ───────────────────────────────
model CandidateChecklistResponse {
  id                     Int                @id @default(autoincrement())
  candidate_user_id      Int
  checklist_template_id  Int
  status                 String             @default("active")
  valid_until            DateTime
  submitted_at           DateTime?
  digital_signature      String?
  candidate_name_signed  String?
  signature_date         DateTime?
  personal_info_collected Boolean  @default(false) // Admin checklist-requests UI tracks this
  superseded_by_id       Int? @unique        // set when candidate completes a new response for the same template; old one is no longer shareable

  candidate_user         User               @relation(fields: [candidate_user_id], references: [id])
  checklist_template     ChecklistTemplate  @relation(fields: [checklist_template_id], references: [id])
  skill_ratings          SkillRating[]
  checklist_requests     ChecklistRequest[]
  consent_shares         ConsentShare[]
  superseded_by          CandidateChecklistResponse? @relation("ChecklistResponseSupersede", fields: [superseded_by_id], references: [id], onDelete: SetNull)
  supersedes             CandidateChecklistResponse? @relation("ChecklistResponseSupersede")
}

// ─── 9. Skill Ratings ───────────────────────────────────────────────
model SkillRating {
  id                    Int                     @id @default(autoincrement())
  checklist_response_id Int
  skill_id              Int
  rating_value          String?
  is_na                 Boolean                 @default(false)
  updated_at            DateTime                @default(now())

  checklist_response    CandidateChecklistResponse @relation(fields: [checklist_response_id], references: [id], onDelete: Cascade)
  skill                 Skill                   @relation(fields: [skill_id], references: [id])

  @@unique([checklist_response_id, skill_id])
}

// ─── 10. Credentials ────────────────────────────────────────────────
model Credential {
  id                   Int           @id @default(autoincrement())
  public_id            String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — used in public credential verification URLs.
    // Internal joins still use INT id.
  candidate_user_id    Int
  document_name        String
  file_url             String
  expiration_date      DateTime?
  reminder_enabled     Boolean       @default(false)
  status               String        @default("active")
  verification_status  String        @default("pending_review")
  reviewed_by          Int?
  review_notes         String?
  uploaded_at          DateTime      @default(now())

  candidate_user       User          @relation(fields: [candidate_user_id], references: [id])
  reviewer             User?         @relation("CredentialReviewer", fields: [reviewed_by], references: [id])
  document_flags       DocumentFlag[]
  consent_shares       ConsentShare[]
}

// ─── 11. Resumes ────────────────────────────────────────────────────
model Resume {
  id                  Int               @id @default(autoincrement())
  candidate_user_id   Int
  file_url            String?
  parsed_data         String?
  is_builder_resume   Boolean           @default(false)
  version_name        String            @default("Master Resume") // e.g., "ICU Resume", "Travel Nurse Resume"
  is_active           Boolean           @default(true) // which version is currently active
  template_id         String?           // reference to template used (clinical, rn, icu, er, etc.)
  ats_score           Int?              // ATS compatibility score (0-100)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @default(now())

  candidate_user      User              @relation(fields: [candidate_user_id], references: [id])
  candidate_profile   CandidateProfile? @relation("CandidateProfileResume")
  consent_shares      ConsentShare[]
}

// ─── 12. Candidate References ───────────────────────────────────────
model CandidateReference {
  id                  Int                @id @default(autoincrement())
  public_id           String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — used in public reference form URL /reference/[publicId].
    // Internal joins still use INT id.
  candidate_user_id   Int
  manager_user_id     Int?
  manager_first_name  String?
  manager_last_name   String?
  manager_job_title   String?
  candidate_job_title String?
  manager_email       String
  manager_phone       String
  facility_name       String
  employment_status   String
  status              String             @default("pending_request")
  requested_at        DateTime           @default(now())

  candidate_user      User               @relation(fields: [candidate_user_id], references: [id])
  manager_user        User?              @relation("ReferenceManager", fields: [manager_user_id], references: [id])
  reference_responses ReferenceResponse[]
  consent_shares      ConsentShare[]
  deletion_requests  ReferenceDeletionRequest[]
}

// ─── 13. Reference Questions ────────────────────────────────────────
model ReferenceQuestion {
  id                Int       @id @default(autoincrement())
  employment_status String
  question_text     String
  response_type     String
  sort_order        Int

  reference_responses ReferenceResponse[]
}

// ─── 14. Reference Responses ────────────────────────────────────────
model ReferenceResponse {
  id                    Int               @id @default(autoincrement())
  candidate_reference_id Int
  question_id           Int
  answer_text           String
  overall_comment       String?
  digital_signature     String?
  signature_date        DateTime?
  submitted_at          DateTime?

  candidate_reference   CandidateReference @relation(fields: [candidate_reference_id], references: [id])
  question              ReferenceQuestion  @relation(fields: [question_id], references: [id])

  @@unique([candidate_reference_id, question_id])
}

// ─── 15. Consent Shares ─────────────────────────────────────────────
model ConsentShare {
  id                    Int                   @id @default(autoincrement())
  candidate_user_id     Int
  client_user_id        Int
  checklist_response_id Int?
  credential_id         Int?
  resume_id             Int?
  reference_id          Int?
  is_deleted            Boolean               @default(false)
  shared_at             DateTime              @default(now())
  expires_at            DateTime

  candidate_user        User                  @relation("CandidateConsentShares", fields: [candidate_user_id], references: [id])
  client_user           User                  @relation("ClientConsentShares", fields: [client_user_id], references: [id])
  checklist_response    CandidateChecklistResponse? @relation(fields: [checklist_response_id], references: [id])
  credential            Credential?           @relation(fields: [credential_id], references: [id])
  resume                Resume?               @relation(fields: [resume_id], references: [id])
  reference             CandidateReference?   @relation(fields: [reference_id], references: [id])
  unlocked_documents    UnlockedDocument[]
}

// ─── 16. Unlocked Documents ─────────────────────────────────────────
model UnlockedDocument {
  id                Int          @id @default(autoincrement())
  client_user_id    Int
  consent_share_id  Int
  entity_type       String
  entity_id         Int
  credits_charged   Int          @default(1)
  unlocked_at       DateTime     @default(now())

  client_user       User         @relation(fields: [client_user_id], references: [id])
  consent_share     ConsentShare @relation(fields: [consent_share_id], references: [id])
}

// ─── 17. Credit Transactions ────────────────────────────────────────
model CreditTransaction {
  id               Int           @id @default(autoincrement())
  organization_id  Int
  transaction_type String
  credit_amount    Int
  description      String
  created_at       DateTime      @default(now())

  organization     Organization  @relation(fields: [organization_id], references: [id])
}

// ─── 18. Invoices ───────────────────────────────────────────────────
model Invoice {
  id               Int           @id @default(autoincrement())
  organization_id  Int
  credit_amount    Int
  total_price      Float
  pdf_url          String?
  created_at       DateTime      @default(now())

  organization     Organization  @relation(fields: [organization_id], references: [id])
}

// ─── 19. Notifications ──────────────────────────────────────────────
model Notification {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  title               String?
  message             String
  type                String    // legacy type field (kept for backwards compat)
  is_read             Boolean   @default(false)
  related_entity_id   Int?
  related_entity_type String?   // lead, call_schedule, shift_request, share_request, vaultsign_document, checklist_request
  metadata            String?   // JSON string for extra data
  snoozed_until       DateTime?
  created_at          DateTime  @default(now())

  // ─── Phase 6 notification fields (added 2026-06-21) ───
  priority            String    @default("info")  // urgent | important | info
  category            String    @default("system") // rtr | document | status | calendar | credit | compliance | system
  is_emailed          Boolean   @default(false)
  action_url          String?   // clickable link (e.g. /recruiter/candidates/5)
  action_label        String?   // button text (e.g. "View profile", "Sign now")

  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, priority])
  @@index([user_id, category])
}

// ─── 19b. Notification Defaults (super admin controlled) ────────────
// Controls which categories get email/SMS/in-app by default for ALL users.
// Urgent priority always emails regardless of these settings.
model NotificationDefault {
  id              Int      @id @default(autoincrement())
  category        String   @unique // rtr | document | status | calendar | credit | compliance | system
  email_enabled   Boolean  @default(true)
  in_app_enabled  Boolean  @default(true)
  sms_enabled     Boolean  @default(false)
  updated_at      DateTime @default(now())
}

// ─── 20. Pending Reminders ──────────────────────────────────────────
model PendingReminder {
  id             Int            @id @default(autoincrement())
  rule_id        Int
  target_user_id Int
  message_preview String
  status         String         @default("awaiting_approval")
  created_at     DateTime       @default(now())
  actioned_by    Int?
  actioned_at    DateTime?

  rule           AutomatedRule  @relation(fields: [rule_id], references: [id])
  target_user    User           @relation("ReminderTarget", fields: [target_user_id], references: [id])
  actioner       User?          @relation("ReminderActioner", fields: [actioned_by], references: [id])
}

// ─── 21. Platform Settings ──────────────────────────────────────────
model PlatformSetting {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique
  setting_value String
  updated_by    Int?
  updated_at    DateTime  @default(now())

  updater       User?     @relation(fields: [updated_by], references: [id])
}

// ─── 22. Feature Flags ──────────────────────────────────────────────
model FeatureFlag {
  id          Int       @id @default(autoincrement())
  flag_name   String    @unique
  is_enabled  Boolean   @default(false)
  updated_by  Int?
  updated_at  DateTime  @default(now())

  updater     User?     @relation(fields: [updated_by], references: [id])
}

// ─── 23. Email Templates ────────────────────────────────────────────
model EmailTemplate {
  id           Int       @id @default(autoincrement())
  template_key String    @unique
  subject      String
  body         String
  updated_by   Int?
  updated_at   DateTime  @default(now())

  updater      User?     @relation(fields: [updated_by], references: [id])
  automated_rules AutomatedRule[]
}

// ─── 24. Announcements ──────────────────────────────────────────────
model Announcement {
  id          Int       @id @default(autoincrement())
  message     String
  target_role String
  is_active   Boolean   @default(false)
  created_at  DateTime  @default(now())
}

// ─── 24b. In-App Banners ────────────────────────────────────────────
model Banner {
  id                Int       @id @default(autoincrement())
  title             String
  description       String?
  image_url         String?   // Supabase Storage URL for banner image
  cta_text          String?   // e.g. "Learn More"
  cta_link          String?   // URL the CTA button navigates to
  target_role       String    // "candidate" | "client_recruiter" | "client_admin"
  is_active         Boolean   @default(true)
  is_pinned         Boolean   @default(false)  // Sticky — always shows first
  expires_at        DateTime? // Auto-hide after this date (null = no expiry)
  carousel_duration Int       @default(5)      // Seconds per slide in carousel
  created_by        Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  creator           User?     @relation(fields: [created_by], references: [id])
}

// ─── 25. Document Flags ─────────────────────────────────────────────
model DocumentFlag {
  id            Int        @id @default(autoincrement())
  credential_id Int
  flag_reason   String
  status        String     @default("pending_review")
  reviewed_by   Int?
  created_at    DateTime   @default(now())

  credential    Credential @relation(fields: [credential_id], references: [id])
  reviewer      User?      @relation("DocumentFlagReviewer", fields: [reviewed_by], references: [id])
}

// ─── 26. System Error Logs ──────────────────────────────────────────
model SystemErrorLog {
  id            Int       @id @default(autoincrement())
  severity      String
  service       String
  error_message String
  created_at    DateTime  @default(now())
}

// ─── 27. Audit Logs ─────────────────────────────────────────────────
model AuditLog {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  role         String?
  action       String
  entity_type  String?
  entity_id    Int?
  ip_address   String?
  details      String?
  created_at   DateTime  @default(now())

  user         User?     @relation(fields: [user_id], references: [id])
}

// ─── 28. Automated Rules ────────────────────────────────────────────
model AutomatedRule {
  id                Int               @id @default(autoincrement())
  rule_name         String
  trigger_condition String
  action_type       String
  template_id       Int?
  is_active         Boolean           @default(true)

  email_template    EmailTemplate?    @relation(fields: [template_id], references: [id])
  pending_reminders PendingReminder[]
}

// ─── 29. Invite Tokens ─────────────────────────────────────────────
model InviteToken {
  id              Int       @id @default(autoincrement())
  public_id       String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — used in invite URLs.
    // Internal joins still use INT id. `token` field is still used for auth.
  token           String    @unique
  email           String
  role            String    @default("candidate")
  token_type      String    @default("candidate_invite")
  invited_by      Int?
  organization_id Int?
  agency_name     String?
  facility_name   String?
  nurse_name      String?
  is_used         Boolean   @default(false)
  expires_at      DateTime
  created_at      DateTime  @default(now())

  inviter         User?     @relation(fields: [invited_by], references: [id])
  organization    Organization? @relation(fields: [organization_id], references: [id])
}

// ─── 30. API Keys ────────────────────────────────────────────────────
model ApiKey {
  id            Int       @id @default(autoincrement())
  service_name  String    @unique
  encrypted_key String
  updated_by    Int?
  updated_at    DateTime  @default(now())

  updater       User?     @relation(fields: [updated_by], references: [id])
}

// ─── 31. Share Requests ─────────────────────────────────────────────
model ShareRequest {
  id                    Int       @id @default(autoincrement())
  candidate_user_id     Int
  client_user_id        Int
  request_checklists    Boolean   @default(false)
  request_credentials   Boolean   @default(false)
  request_resume        Boolean   @default(false)
  request_references    Boolean   @default(false)
  // JSON array of specific credential names the recruiter requested
  // (e.g. ["BLS (Basic Life Support)", "ACLS (Advanced Cardiovascular Life Support)"]).
  // Used for auto-matching against the candidate's credential vault.
  // Null = legacy request (only broad categories), empty array = no specific docs.
  requested_documents   String?
  status                String    @default("pending")
  message               String?
  created_at            DateTime  @default(now())

  candidate_user        User      @relation("CandidateShareRequests", fields: [candidate_user_id], references: [id])
  client_user           User      @relation("ClientShareRequests", fields: [client_user_id], references: [id])
}

// ─── 32. Calendar Availability (Candidate) ──────────────────────────
model CalendarAvailability {
  id                Int       @id @default(autoincrement())
  candidate_user_id Int
  day_of_week       Int?      // 0=Sun, 1=Mon, ..., 6=Sat (null for specific dates)
  specific_date     DateTime? // For block-out dates or one-time overrides
  start_time        String?   // "09:00" format, null = all day
  end_time          String?   // "17:00" format, null = all day
  is_available      Boolean   @default(true) // true = available, false = blocked
  is_recurring      Boolean   @default(false) // true = weekly recurring
  label             String?   // "Lunch break", "Night shift available", etc.
  template_name     String?   // "Morning Person", "Night Owl", etc.
  min_notice_hours  Int       @default(24)
  shift_duration_pref String? // "8hr", "12hr", "4hr_min"
  availability_status String  @default("actively_looking") // actively_looking, open, not_available

  candidate_user    User      @relation(fields: [candidate_user_id], references: [id], onDelete: Cascade)
}

// ─── 33. Calendar Shares ────────────────────────────────────────────
model CalendarShare {
  id                Int       @id @default(autoincrement())
  candidate_user_id Int
  recruiter_user_id Int?      // Direct share to specific recruiter
  share_token       String?   @unique // For link-based sharing
  share_type        String    @default("direct") // "direct" or "link"
  expiry_type       String    @default("30_days") // "1_day", "1_month", "1_year", "never"
  expires_at        DateTime?
  is_revoked        Boolean   @default(false)
  created_at        DateTime  @default(now())

  candidate_user    User      @relation("CandidateCalendarShares", fields: [candidate_user_id], references: [id], onDelete: Cascade)
  recruiter_user    User?     @relation("RecruiterCalendarShares", fields: [recruiter_user_id], references: [id])
}

// ─── 34. Recruiter Leads ────────────────────────────────────────────
model RecruiterLead {
  id                Int       @id @default(autoincrement())
  recruiter_user_id Int
  organization_id   Int
  first_name        String
  last_name         String
  email             String?
  phone             String?
  job_title         String?
  specialty         String?
  reached_for       String?   // What position/role they were contacted for
  remark            String?   // How the call went, what was discussed
  source            String    @default("cold_call") // cold_call, referral, job_board, walk_in, linkedin, other
  pipeline_stage    String    @default("new_lead") // new_lead, doc_pending, interested, submitted, interview_stage, offer_sent, offer_accepted, onboarding, on_assignment, inactive, not_interested, blacklisted
  star_rating       Int?      // 1-5, optional
  is_active         Boolean   @default(true)
  is_deleted        Boolean   @default(false) // Soft delete — some calendar routes check this
  is_platform_candidate Boolean @default(false) // Lead was found in platform pool
  is_no_longer_interested Boolean @default(false) // Lead opted out
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())

  // ─── BOB Phase 1 fields (added 2026-06-20) ───
  candidate_user_id      Int?      // Links to a platform User once they sign up
  tag                    String    @default("cold") // hot | warm | cold | inactive (auto-updated)
  last_activity_at       DateTime  @default(now())
  last_activity_type     String?
  blacklist_reason       String?
  blacklisted_at         DateTime?
  blacklisted_by_user_id Int?
  rtr_denial_count       Int       @default(0) // 5 denials → auto not_interested
  next_action            String?
  next_action_at         DateTime?
  notes                  String?

  // ─── BOB Phase 2 fields (added 2026-06-20) ───
  contract_start_date    DateTime?  // When the contract starts → cron auto-flips to on_assignment
  requested_email_at     DateTime?  // When recruiter last requested candidate's email
  requested_phone_at     DateTime?  // When recruiter last requested candidate's phone
  requested_calendar_at  DateTime?  // When recruiter last requested calendar access

  // Relations
  recruiter_user         User      @relation(fields: [recruiter_user_id], references: [id], onDelete: Cascade)
  organization           Organization @relation(fields: [organization_id], references: [id])
  candidate_user         User?     @relation("RecruiterLeadCandidate", fields: [candidate_user_id], references: [id], onDelete: SetNull)
  blacklisted_by         User?     @relation("RecruiterLeadBlacklistedBy", fields: [blacklisted_by_user_id], references: [id], onDelete: SetNull)
  call_schedules         CallSchedule[]
  call_logs              CallLog[]
  activities             RecruiterLeadActivity[]
  vault_sign_documents   VaultSignDocument[] @relation("VaultSignDocumentCandidateLead")

  @@index([recruiter_user_id, pipeline_stage])
  @@index([organization_id, pipeline_stage])
  @@index([last_activity_at])
  @@index([tag])
  @@index([candidate_user_id])
}

// ─── 34b. Recruiter Lead Activity (audit trail for BOB) ─────────────
// One row per interaction. Powers the Activity Timeline tab in candidate profile.
model RecruiterLeadActivity {
  id            Int      @id @default(autoincrement())
  lead_id       Int
  activity_type String   // lead_created, rtr_sent, rtr_signed, rtr_denied, doc_requested, doc_uploaded, status_changed, etc.
  description   String   // Human-readable summary
  actor_user_id Int?
  actor_type    String   @default("recruiter") // recruiter | admin | candidate | system
  metadata      Json     @default("{}") // structured data
  created_at    DateTime @default(now())

  lead          RecruiterLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  actor         User?         @relation("RecruiterLeadActivityActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([lead_id, created_at])
  @@index([actor_user_id])
}


// ─── 35. Call Schedules ─────────────────────────────────────────────
model CallSchedule {
  id                Int       @id @default(autoincrement())
  lead_id           Int
  recruiter_user_id Int
  schedule_type     String?   // 'specific_date' | 'month_range' — null for legacy rows
  scheduled_date    DateTime? // Specific date/time (null for month-range)
  scheduled_month   String?   // "2026-12" for month-range scheduling
  scheduled_year    Int?      // 2026 for month-range scheduling
  status            String    @default("scheduled") // scheduled, completed, rescheduled, cancelled, no_answer
  remark            String?
  reminder_sent_at  DateTime?
  created_at        DateTime  @default(now())

  lead              RecruiterLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  recruiter_user    User      @relation(fields: [recruiter_user_id], references: [id], onDelete: Cascade)
  call_logs         CallLog[]
}

// ─── 36. Call Logs ──────────────────────────────────────────────────
model CallLog {
  id                Int       @id @default(autoincrement())
  lead_id           Int
  call_schedule_id  Int?
  recruiter_user_id Int
  call_date         DateTime  @default(now())
  outcome           String    // good, no_answer, voicemail, not_interested
  remark            String?   // What was discussed
  next_action       String?   // What the next step is
  created_at        DateTime  @default(now())

  lead              RecruiterLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  call_schedule     CallSchedule? @relation(fields: [call_schedule_id], references: [id], onDelete: SetNull)
  recruiter_user    User      @relation(fields: [recruiter_user_id], references: [id], onDelete: Cascade)
}

// ─── 37. Recruiter Availability ─────────────────────────────────────
model RecruiterAvailability {
  id                Int       @id @default(autoincrement())
  recruiter_user_id Int
  day_of_week       Int?      // 0=Sun, 1=Mon, ..., 6=Sat
  specific_date     DateTime?
  start_time        String?   // "09:00"
  end_time          String?   // "17:00"
  is_available      Boolean   @default(true)
  is_recurring      Boolean   @default(false)
  label             String?   // "Free before lunch", "Available evenings"
  created_at        DateTime  @default(now())

  recruiter_user    User      @relation(fields: [recruiter_user_id], references: [id], onDelete: Cascade)
}

// ─── 38. Reference Deletion Requests ────────────────────────────────
model ReferenceDeletionRequest {
  id                  Int       @id @default(autoincrement())
  candidate_user_id   Int
  reference_id        Int
  reason              String
  status              String    @default("pending") // pending, approved, rejected
  reviewed_by         Int?
  review_notes        String?
  reviewed_at         DateTime?
  created_at          DateTime  @default(now())

  candidate_user      User               @relation("CandidateDeletionRequests", fields: [candidate_user_id], references: [id])
  reference           CandidateReference @relation(fields: [reference_id], references: [id])
  reviewer            User?              @relation("AdminDeletionReviews", fields: [reviewed_by], references: [id])
}

// ─── 39. Shift Requests ─────────────────────────────────────────────
model ShiftRequest {
  id                Int       @id @default(autoincrement())
  recruiter_user_id Int
  candidate_user_id Int
  shift_date        DateTime
  start_time        String?
  end_time          String?
  position          String?   // Role/position for the shift
  facility_name     String?
  notes             String?
  status            String    @default("pending") // pending, accepted, declined, expired
  response_deadline DateTime? // When the request auto-expires
  responded_at      DateTime?
  response_note     String?
  created_at        DateTime  @default(now())

  recruiter_user    User      @relation("RecruiterShiftRequests", fields: [recruiter_user_id], references: [id])
  candidate_user    User      @relation("CandidateShiftRequests", fields: [candidate_user_id], references: [id])
}

// ─── 40. VaultSign Templates ────────────────────────────────────────
model VaultSignTemplate {
  id                      Int       @id @default(autoincrement())
  name                    String
  description             String?
  document_type           String    @default("custom") // right_to_represent, pre_offer_acceptance, offer_letter, nda, background_check_authorization, employment_contract, onboarding_form, custom
  source_type             String    @default("word") // word or pdf
  original_file_url       String    // .docx or .pdf in Supabase Storage
  tiptap_content          String?   // TipTap document JSON for word templates
  predefined_sign_fields  String    @default("[]") // JSON array of preset field positions
  placeholder_variables   String    @default("[]") // JSON array of {key, label, description, category}
  header_config           String    @default("{}") // JSON: {show_logo, show_company_name, show_contact, show_address, show_document_title}
  footer_config           String    @default("{}") // JSON: {show_rights_reserved, show_powered_by, show_page_numbers}
  show_header_footer      Boolean   @default(true) // Combined toggle for header & footer
  is_active               Boolean   @default(true)
  created_by              Int
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now())

  creator                 User      @relation("VaultSignTemplateCreator", fields: [created_by], references: [id])
  vault_sign_documents    VaultSignDocument[]
}

// ─── 41. VaultSign Documents ────────────────────────────────────────
model VaultSignDocument {
  id                       Int       @id @default(autoincrement())
  public_id                String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — used in public document URLs.
    // Internal joins still use INT id.
  organization_id          Int
  created_by_user_id       Int
  template_id              Int?
  document_name            String
  document_type            String    @default("custom")
  source_type              String    @default("word") // word or pdf
  original_file_url        String?   // uploaded .docx or .pdf in Supabase Storage
  tiptap_content           String?   // saved TipTap editor state JSON
  edited_pdf_url           String?   // PDF generated from Word editor
  final_document_url       String?   // completed signed PDF
  signing_order            String    @default("sequential") // sequential, parallel
  expiry_date              DateTime
  personal_message         String?
  status                   String    @default("draft") // draft, sent, partially_signed, completed, declined, expired, voided
  placeholder_values       String    @default("{}") // JSON object {key: value} — all variable values filled by recruiter
  sign_fields              String    @default("[]") // JSON array of {id, type, page, x_percent, y_percent, width_percent, height_percent, assigned_to_signer_index, label, required, value}
  header_config            String    @default("{}") // JSON: {show_logo, show_company_name, show_contact, show_address, show_document_title, logo_url}
  footer_config            String    @default("{}") // JSON: {show_rights_reserved, show_powered_by, show_page_numbers}
  show_header_footer       Boolean   @default(true) // Combined toggle for header & footer
  audit_trail              String    @default("[]") // JSON array of {event, user_name, ip_address, device_info, timestamp}
  document_hash            String?   // SHA-256 of final PDF
  revised_from_document_id Int?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now())

  // BOB Phase 1 (added 2026-06-20) — links document to a recruiter lead
  candidate_lead_id        Int?
  candidate_lead           RecruiterLead? @relation("VaultSignDocumentCandidateLead", fields: [candidate_lead_id], references: [id], onDelete: SetNull)

  organization             Organization      @relation(fields: [organization_id], references: [id])
  creator                  User              @relation("VaultSignDocumentCreator", fields: [created_by_user_id], references: [id])
  template                 VaultSignTemplate? @relation(fields: [template_id], references: [id])
  revised_from_document    VaultSignDocument? @relation("VaultSignDocumentRevision", fields: [revised_from_document_id], references: [id])
  revised_documents        VaultSignDocument[] @relation("VaultSignDocumentRevision")
  signers                  VaultSignSigner[]
  reminders                VaultSignReminder[]

  // Marketplace — RTR (Right to Represent) link
  rtr_submissions          CandidateSubmission[] @relation("SubmissionRTRDocument")
}

// ─── 42. VaultSign Signers ──────────────────────────────────────────
model VaultSignSigner {
  id                     Int       @id @default(autoincrement())
  public_id              String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // External-facing UUID — used in public signing page URL.
    // Internal joins still use INT id. sign_token is still used for auth.
  document_id            Int
  user_id                Int?      // null for external signers
  name                   String
  email                  String
  role                   String    // Candidate, Recruiter, Client Employer, Witness, etc.
  signer_index           Int       // 0-based index, used to assign fields
  signing_order_position Int       @default(1) // 1,2,3 for sequential. All same for parallel.
  status                 String    @default("pending") // pending, sent, viewed, signed, declined
  signed_at              DateTime?
  declined_at            DateTime?
  decline_reason         String?
  sign_token             String    @unique
  token_used             Boolean   @default(false)
  ip_address             String?
  device_info            String?
  signature_data         String?   // JSON {type, font_name, text, image_base64}
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now())

  document               VaultSignDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user                   User?     @relation("VaultSignSignerUser", fields: [user_id], references: [id])
  reminders              VaultSignReminder[]
}

// ─── 43. VaultSign Reminders ────────────────────────────────────────
model VaultSignReminder {
  id            Int       @id @default(autoincrement())
  document_id   Int
  signer_id     Int
  reminder_type String    @default("auto") // auto, manual
  sent_at       DateTime  @default(now())
  created_at    DateTime  @default(now())

  document      VaultSignDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  signer        VaultSignSigner   @relation(fields: [signer_id], references: [id], onDelete: Cascade)
}

// ─── 44. Document Verification ──────────────────────────────────────
model DocumentVerification {
  id                Int       @id @default(autoincrement())
  document_id       String    @unique          // e.g. MZV-MQFNP5GX
  verification_code String    @unique          // e.g. 2BA1C730
  document_type     String                      // checklist, baa, invoice, reference, vaultsign
  source_id         Int?                        // FK to the source record (CandidateChecklistResponse, VaultSignDocument, etc.)
  candidate_name    String?
  document_name     String?
  signed_at         DateTime?
  status            String    @default("active") // active, voided, expired
  pdf_hash          String?                     // SHA-256 of the PDF file
  verified_count    Int       @default(0)        // How many times someone verified this document
  last_verified_at  DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())
}

// ─── 45. Email Campaigns ────────────────────────────────────────────
// Batch email sending to filtered user segments from Super Admin.
// Tracks per-recipient delivery status for audit and analytics.
model EmailCampaign {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  subject           String    @db.VarChar(500)
  body              String    // HTML or plain text body (campaign content — wrapped by branded template at send time)
  from_name         String?   @db.VarChar(100)
    // Custom sender name shown in the email "From" field (default: "MyZipVault")
  reply_to          String?   @db.VarChar(255)
    // Custom reply-to email (default: BREVO_SENDER_EMAIL)
  logo_url          String?   @db.VarChar(500)
    // Logo image URL for the branded email header (if null, text logo is used)
  accent_color      String?   @db.VarChar(20)
    // Accent color for the branded email top bar (default: #0A66C2)
  target_role       String    @default("all")
    // 'all' | 'candidate' | 'client_recruiter' | 'client_admin' |
    // 'platform_admin' | 'super_admin' | 'employer'
  target_filter     String?
    // JSON string for additional filters, e.g. {"specialty":"ICU","state":"CA"}
    // null = no additional filters
  status            String    @default("draft")
    // 'draft' | 'queued' | 'sending' | 'sent' | 'partial_failure' | 'failed' | 'cancelled'
  total_recipients  Int       @default(0)
  sent_count        Int       @default(0)
  failed_count      Int       @default(0)
  created_by        Int?
  created_at        DateTime  @default(now())
  started_at        DateTime?
  completed_at      DateTime?
  updated_at        DateTime  @default(now())

  creator           User?                     @relation("EmailCampaignCreator", fields: [created_by], references: [id], onDelete: SetNull)
  recipients        EmailCampaignRecipient[]

  @@index([created_at(sort: Desc)])
  @@index([status])
  @@index([target_role])
}

// ─── 46. Email Campaign Recipients ──────────────────────────────────
// Per-recipient delivery tracking for an EmailCampaign.
// One row per (campaign, recipient) pair.
model EmailCampaignRecipient {
  id                Int       @id @default(autoincrement())
  campaign_id       Int
  recipient_user_id Int?
    // nullable: if a user is deleted, we keep the historical delivery record
    // but lose the link to which user it was
  recipient_email   String    @db.VarChar(255)
  recipient_name    String?   @db.VarChar(255)
    // snapshot of recipient's name at send time
  status            String    @default("pending")
    // 'pending' | 'sent' | 'failed' | 'bounced' | 'complained' | 'unsubscribed'
  error_message     String?
  brevo_message_id  String?   @db.VarChar(255)
    // Brevo's message ID for tracking opens/clicks via webhook
  tracking_token    String?  @db.VarChar(64) @unique
    // Per-recipient unguessable token for tracking pixel + click redirect
  queued_at         DateTime  @default(now())
  sent_at           DateTime?
  delivered_at      DateTime?
  opened_at         DateTime?
  clicked_at        DateTime?

  campaign          EmailCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  recipient_user    User?         @relation("EmailCampaignRecipientUser", fields: [recipient_user_id], references: [id], onDelete: SetNull)

  @@index([campaign_id])
  @@index([status])
  @@index([recipient_user_id])
  @@index([recipient_email])
}

// ─── 46b. Unsubscribe Suppression List ──────────────────────────────
// When a recipient clicks "Unsubscribe" in a campaign email or Brevo
// reports an unsubscribe/complaint event, their email is added here.
// The campaign send route filters out any email in this list.
model EmailUnsubscribe {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(255)
  source            String    @default("manual")
    // 'manual' (clicked unsubscribe link) | 'brevo' (Brevo webhook) | 'admin' (superadmin added)
  source_campaign_id Int?
  created_at        DateTime  @default(now())

  @@index([email])
}

// ─── 47. Compliance Bundles ─────────────────────────────────────────
// Agency-specific bundles that group checklist + document requests.
// Each org gets 5 free bundle slots (controlled via platform_settings
// key 'bundle_limit_<org_id>', default 5 if not set).
// Super Admin can assign additional slots.
model ComplianceBundle {
  id                    Int       @id @default(autoincrement())
  organization_id       Int
  name                  String    @db.VarChar(255)
  description           String?
  profession            String?   @db.VarChar(100)
  specialty             String?   @db.VarChar(100)
  checklist_template_id Int
  documents             String    @default("[]")
    // JSON array: ["credential", "resume", "reference"]
  credit_cost           Int       @default(1)
    // Calculated: 1 (checklist request) + documents.length
  is_active             Boolean   @default(true)
  created_by            Int
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())

  organization          Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  checklist_template    ChecklistTemplate @relation(fields: [checklist_template_id], references: [id])
  creator               User            @relation("ComplianceBundleCreator", fields: [created_by], references: [id])

  @@index([organization_id, is_active])
}

// ─── 48. Candidate Pools (Saved candidate groups) ───────────────────
// Recruiters organize candidates into named groups ("playlists").
// Each pool belongs to a specific recruiter within an organization.
model CandidatePool {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  description       String?
  recruiter_user_id Int
  organization_id   Int
  color             String    @default("#059669") @db.VarChar(20)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())

  recruiter         User          @relation("CandidatePoolRecruiter", fields: [recruiter_user_id], references: [id], onDelete: Cascade)
  organization      Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  members           CandidatePoolMember[]

  @@index([recruiter_user_id, organization_id])
}

// ─── 49. Candidate Pool Members ─────────────────────────────────────
// Junction table: which candidates are in which pools.
// A candidate can be in multiple pools simultaneously.
model CandidatePoolMember {
  id                Int       @id @default(autoincrement())
  pool_id           Int
  candidate_user_id Int
  notes             String?
  added_at          DateTime  @default(now())

  pool              CandidatePool @relation(fields: [pool_id], references: [id], onDelete: Cascade)
  candidate         User          @relation("CandidatePoolCandidate", fields: [candidate_user_id], references: [id], onDelete: Cascade)

  @@unique([pool_id, candidate_user_id])
  @@index([pool_id])
  @@index([candidate_user_id])
}

// ─────────────────────────────────────────────────────────────────────
// 50. Marketplace: CandidateRecord — the 1M healthcare candidate pool
// ─────────────────────────────────────────────────────────────────────
// This is DIFFERENT from the User model. The 1M records in the platform
// pool are NOT users (no account, no password). They become Users only
// when they self-claim their profile via signup.
//
// Two paths create records here:
//   Path A — platform_pool: imported via CSV (basic info only, no resumes/docs)
//   Path B — recruiter_submitted: a recruiter brings an outside candidate
//   Self-signup — candidate signs up themselves, then claims an existing
//     CandidateRecord by email match (linked via claimed_by_user_id)
model CandidateRecord {
  id                       Int       @id @default(autoincrement())
  public_id                String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name               String?
  last_name                String?
  city                     String?
  state                    String?
  job_title                String?
  specialty                String?
  profession               String?  // nursing, allied, physician, non-clinical, IT
  years_of_experience      Int?
  willing_to_relocate       Boolean   @default(false)
  license_number           String?
  license_state            String?
  npi_number               String?  // National Provider Identifier (for physicians)

  // Source tracking
  source                   String    @default("platform_pool")
    // 'platform_pool' | 'recruiter_submitted' | 'self_signup'
  original_owner_recruiter_id Int?  // FK to User (Path B recruiter who brought them)
  imported_at              DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Candidate self-claim (when they sign up using matching email)
  claimed_by_user_id       Int?     // FK to User (if candidate claimed this profile)
  claimed_at               DateTime?

  // Relations
  original_owner           User?                  @relation("CandidateRecordOwner", fields: [original_owner_recruiter_id], references: [id])
  claimed_by               User?                  @relation("CandidateRecordClaimedBy", fields: [claimed_by_user_id], references: [id])
  contact_info             CandidateContactInfo[]
  submissions              CandidateSubmission[]
  ownership_windows        CandidateOwnershipWindow[]
  contact_reveals          CandidateContactReveal[]

  @@index([first_name, last_name])
  @@index([specialty, state])
  @@index([source])
  @@index([original_owner_recruiter_id])
}

// ─────────────────────────────────────────────────────────────────────
// 51. Marketplace: CandidateContactInfo — append-only email/phone history
// ─────────────────────────────────────────────────────────────────────
// Contact info can be ADDED but never DELETED via the UI. The latest
// entry of each type is marked is_primary=true. Deletion requires admin
// via the email-to-platform flow.
//
// All values are stored TWICE:
//   value          — original display format (e.g., "+1 (555) 123-4567")
//   value_normalized — for dedup: lowercase+trimmed email, or E.164 phone
//
// Recruiter-added contact info stays private for 90 days, then becomes
// public. The is_visible_to_others + visible_after fields control this.
model CandidateContactInfo {
  id                       Int       @id @default(autoincrement())
  candidate_record_id      Int
  type                     String    // 'email' | 'phone'
  value                    String    // original display format
  value_normalized         String    // for dedup

  // Provenance
  added_by_recruiter_id    Int?      // FK to User
  added_by_candidate       Boolean   @default(false)
  added_at                 DateTime  @default(now())

  // Primary flag — latest entry auto-marked primary (enforced in app)
  is_primary               Boolean   @default(false)

  // Visibility — recruiter-added info stays private for 90 days
  is_visible_to_others     Boolean   @default(true)
  visible_after            DateTime? // null = immediately visible

  // Soft delete (admin only, via email-to-platform flow)
  deleted_at               DateTime?
  deleted_by_admin_id      Int?
  deletion_reason          String?

  // Relations
  candidate_record         CandidateRecord        @relation(fields: [candidate_record_id], references: [id], onDelete: Cascade)
  added_by_recruiter       User?                  @relation("ContactInfoAddedByRecruiter", fields: [added_by_recruiter_id], references: [id])
  contact_reveals          CandidateContactReveal[]

  @@index([candidate_record_id])
  @@index([value_normalized])
}

// ─────────────────────────────────────────────────────────────────────
// 52. Marketplace: JobPosting — jobs posted by the platform
// ─────────────────────────────────────────────────────────────────────
// Jobs have two visibility modes:
//   is_public = false → only recruiters can see (recruiter-facing)
//   is_public = true  → candidates can browse + apply directly (Indeed-style)
//
// Compensation + commission fields are recruiter-side only. Candidates
// see only salary_display (e.g., "$200k").
model JobPosting {
  id                       Int       @id @default(autoincrement())
  public_id                String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  profession               String?
  specialty                String?
  job_title                String?
  employment_type          String?   // permanent | travel | contract | per_diem | locum
  city                     String?
  state                    String?
  is_remote                Boolean   @default(false)

  // Compensation (recruiter-side)
  salary_min               Decimal?  @db.Decimal(12, 2)
  salary_max               Decimal?  @db.Decimal(12, 2)
  salary_display           String?   // e.g., "$200k" — shown to candidates
  currency                 String    @default("USD")

  // Commission (recruiter-side)
  commission_amount        Decimal?  @db.Decimal(12, 2)
  commission_percentage    Decimal?  @db.Decimal(5, 2)
  commission_type          String?   // 'flat' | 'percentage'

  // Description
  description              String?
  requirements             String?   // JSON array
  nice_to_have             String?   // JSON array

  // Status
  status                   String    @default("draft") // draft | open | paused | filled | cancelled
  is_public                Boolean   @default(false)
  open_date                DateTime?
  close_date               DateTime?

  // Attribution
  posted_by_user_id        Int?
  organization_id          Int?

  // Tracking
  views_count              Int       @default(0)
  applications_count      Int       @default(0)
  submissions_count       Int       @default(0)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Relations
  posted_by                User?            @relation("JobPostingPoster", fields: [posted_by_user_id], references: [id])
  organization             Organization?    @relation("JobPostingOrganization", fields: [organization_id], references: [id])
  submissions               CandidateSubmission[]
  reports                   RecruiterReport[]
  employer_reviews          RecruiterReview[]  @relation("JobPostingEmployerReviews")

  @@index([status, is_public])
  @@index([profession, specialty])
  @@index([state, city])
}

// ─────────────────────────────────────────────────────────────────────
// 53. Marketplace: CandidateSubmission — recruiter submits candidate → job
// ─────────────────────────────────────────────────────────────────────
// FIRST-SUBMISSION-WINS is enforced by the unique constraint on
// (candidate_record_id, job_id). The millisecond timestamp is used for
// tiebreaks (with reputation score as a secondary tiebreaker).
model CandidateSubmission {
  id                       Int       @id @default(autoincrement())
  candidate_record_id      Int
  job_id                   Int
  recruiter_user_id        Int?      // nullable for self-apply submissions (candidate applied directly, no recruiter)
  organization_id          Int?
  submission_type          String    @default("recruiter") // 'recruiter' | 'self_apply'

  // FIRST-SUBMISSION-WINS — millisecond-precision timestamp
  submitted_at_ms          BigInt
  submitted_at             DateTime  @default(now())

  // RTR (Right to Represent) — link to VaultSign document
  rtr_vault_sign_document_id Int?
  rtr_signed_at            DateTime?

  // Status workflow
  status                   String    @default("submitted")
    // 'submitted' | 'reviewing' | 'interview' | 'offer' | 'placed' | 'rejected' | 'withdrawn'
  status_history           String?   // JSON array of {status, changed_at, changed_by_user_id}

  // Notes
  recruiter_notes          String?

  // Tiebreak info
  tiebreak_recruiter_reputation Float?
  tiebreak_won             Boolean   @default(false)

  // Revenue tracking (captured when status=placed)
  placement_fee            Decimal?  @db.Decimal(12, 2)
  recruiter_payout         Decimal?  @db.Decimal(12, 2)
  platform_payout          Decimal?  @db.Decimal(12, 2)
  original_owner_residual  Decimal?  @db.Decimal(12, 2)
  payout_split_phase       String?   // 'exclusive' | 'residual' | 'open'
  placed_at                DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Relations
  candidate_record         CandidateRecord     @relation(fields: [candidate_record_id], references: [id])
  job                      JobPosting          @relation(fields: [job_id], references: [id])
  recruiter                User?               @relation("SubmissionRecruiter", fields: [recruiter_user_id], references: [id])
  organization             Organization?       @relation("SubmissionOrganization", fields: [organization_id], references: [id])
  rtr_document             VaultSignDocument?  @relation("SubmissionRTRDocument", fields: [rtr_vault_sign_document_id], references: [id])
  candidate_reviews        RecruiterReview[]   @relation("SubmissionCandidateReviews")
  reports                   RecruiterReport[]

  @@unique([candidate_record_id, job_id])
  @@index([recruiter_user_id])
  @@index([job_id])
  @@index([status])
  @@index([submitted_at_ms])
}

// ─────────────────────────────────────────────────────────────────────
// 54. Marketplace: CandidateOwnershipWindow — 90-day exclusive + 90-180 residual
// ─────────────────────────────────────────────────────────────────────
// One active ownership window per CandidateRecord (enforced by partial
// unique index on (candidate_record_id) WHERE is_active = true).
//
// Phases:
//   0-90 days:  'exclusive' — only the owner recruiter can see/submit. 75/25 split.
//   90-180 days: 'residual'  — anyone can submit. Original owner gets 2% residual
//                              FROM THE NEW RECRUITER'S 70%. 68/30/2 split.
//   180+ days:  'expired'   — standard 70/30 split, no residual.
//
// The clock starts at candidate CREATION, not at RTR signature.
model CandidateOwnershipWindow {
  id                       Int       @id @default(autoincrement())
  candidate_record_id      Int
  recruiter_user_id        Int
  organization_id          Int?

  // Window timestamps (clock starts at candidate CREATION)
  exclusive_window_start   DateTime
  exclusive_window_end     DateTime  // = exclusive_start + 90 days
  residual_window_end      DateTime  // = exclusive_end + 90 days

  // Current state (stored for fast queries; refreshed by cron)
  current_phase            String    @default("exclusive")
    // 'exclusive' | 'residual' | 'expired'
  phase_computed_at        DateTime  @default(now())

  // Payout splits applicable during each phase (configurable per window)
  exclusive_recruiter_pct  Decimal   @default(75.00) @db.Decimal(5, 2)
  exclusive_platform_pct   Decimal   @default(25.00) @db.Decimal(5, 2)
  residual_recruiter_pct   Decimal   @default(68.00) @db.Decimal(5, 2)
  residual_platform_pct    Decimal   @default(30.00) @db.Decimal(5, 2)
  residual_original_pct    Decimal   @default(2.00)  @db.Decimal(5, 2)
  open_recruiter_pct       Decimal   @default(70.00) @db.Decimal(5, 2)
  open_platform_pct        Decimal   @default(30.00) @db.Decimal(5, 2)

  is_active                Boolean   @default(true)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Relations
  candidate_record         CandidateRecord     @relation(fields: [candidate_record_id], references: [id])
  recruiter                User                @relation("OwnershipWindowRecruiter", fields: [recruiter_user_id], references: [id])
  organization             Organization?       @relation("OwnershipWindowOrganization", fields: [organization_id], references: [id])

  @@index([recruiter_user_id])
  @@index([current_phase])
}

// ─────────────────────────────────────────────────────────────────────
// 55. Marketplace: CandidateContactReveal — credit-gated contact info unlock
// ─────────────────────────────────────────────────────────────────────
// When a recruiter pays credits to reveal a candidate's email/phone,
// a record is created here. The reveal is valid for 90 days (matches the
// ownership window concept — recruiter has the candidate "fresh" for
// 90 days after paying).
//
// This is SEPARATE from the existing UnlockedDocument model, which is for
// unlocking shared documents (resumes, credentials, etc.) via the
// consentShare flow. The two coexist.
model CandidateContactReveal {
  id                       Int       @id @default(autoincrement())
  candidate_record_id      Int
  recruiter_user_id        Int
  organization_id          Int
  contact_info_id          Int?
  credits_charged          Int       @default(0)
  revealed_at             DateTime  @default(now())
  expires_at              DateTime
  is_expired              Boolean   @default(false)

  // Relations
  candidate_record         CandidateRecord     @relation(fields: [candidate_record_id], references: [id])
  recruiter                User                @relation("ContactRevealRecruiter", fields: [recruiter_user_id], references: [id])
  organization             Organization       @relation("ContactRevealOrganization", fields: [organization_id], references: [id])
  contact_info             CandidateContactInfo? @relation(fields: [contact_info_id], references: [id])

  @@index([recruiter_user_id])
}

// ─────────────────────────────────────────────────────────────────────
// 56. Marketplace: RecruiterReputationScore — aggregate score per recruiter
// ─────────────────────────────────────────────────────────────────────
// Computed by a cron job every 6 hours (not real-time — too expensive
// to recalculate on every review submission). The overall_score is a
// weighted average of the 5 sub-dimensions.
//
// Used as the tiebreaker for millisecond-tied first submissions.
model RecruiterReputationScore {
  recruiter_user_id        Int       @id
  total_reviews            Int       @default(0)
  verified_reviews         Int       @default(0)

  // Aggregate scores (0-10, weighted)
  overall_score            Decimal   @default(0.0) @db.Decimal(3, 1)
  professionalism_avg      Decimal   @default(0.0) @db.Decimal(3, 1)
  communication_avg        Decimal   @default(0.0) @db.Decimal(3, 1)
  job_match_avg            Decimal   @default(0.0) @db.Decimal(3, 1)
  process_speed_avg        Decimal   @default(0.0) @db.Decimal(3, 1)
  post_placement_avg       Decimal   @default(0.0) @db.Decimal(3, 1)

  // Other reputation signals
  total_placements         Int       @default(0)
  avg_time_to_fill_days    Decimal?  @db.Decimal(5, 1)
  candidate_retention_pct  Decimal?  @db.Decimal(5, 2)  // 0-100
  avg_response_hours       Decimal?  @db.Decimal(5, 1)

  // Status / badges
  badge_tier               String    @default("none") // 'none' | 'verified' | 'top'
  is_top_recruiter         Boolean   @default(false)
  is_verified_recruiter    Boolean   @default(false)
  last_calculated_at       DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Relations
  recruiter                User      @relation(fields: [recruiter_user_id], references: [id])
}

// ─────────────────────────────────────────────────────────────────────
// 57. Marketplace: RecruiterReview — individual reviews (multi-dimensional)
// ─────────────────────────────────────────────────────────────────────
// Multi-dimensional ratings (5 sub-scores 1-10) + free-text comment +
// recruiter reply (one per review, can't edit).
//
// Verification gates: only candidates with a confirmed submission can
// rate. Rating window: 30-180 days after placement. One rating per
// placement per reviewer.
//
// Negative reviews (≤5/10) get a "Dispute Review" button available to
// the reviewed recruiter — see RecruiterReviewDispute model.
model RecruiterReview {
  id                       Int       @id @default(autoincrement())
  recruiter_user_id        Int       // who is being reviewed
  reviewer_user_id         Int?      // who left the review (null = anonymous)
  reviewer_role            String    // 'candidate' | 'employer' | 'recruiter_peer'

  // Multi-dimensional ratings (each 1-10)
  professionalism          Int
  communication            Int
  job_match                Int
  process_speed           Int
  post_placement           Int

  // Free-text comment (min 50 chars for negative reviews, enforced in app)
  comment                  String?   @db.VarChar(500)

  // Status
  is_anonymous             Boolean   @default(false)
  is_verified_placement    Boolean   @default(false) // tied to actual CandidateSubmission
  status                   String    @default("active") // 'active' | 'flagged' | 'removed'

  // Recruiter reply (one per review, can't edit)
  recruiter_reply          String?   @db.VarChar(300)
  recruiter_replied_at    DateTime?

  // Dispute flag
  has_dispute              Boolean   @default(false)
  dispute_status           String?   // 'pending' | 'investigating' | 'upheld' | 'removed' | 'annotated' | 'dismissed'
  admin_annotation         String?   @db.VarChar(500) // shown publicly under the review

  // Linkage
  submission_id           Int?
  job_id                  Int?

  // Timestamps
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  // Relations
  recruiter                User                @relation("RecruiterReviewsReceived", fields: [recruiter_user_id], references: [id])
  reviewer                 User?               @relation("RecruiterReviewsGiven", fields: [reviewer_user_id], references: [id])
  submission               CandidateSubmission? @relation("SubmissionCandidateReviews", fields: [submission_id], references: [id])
  job                      JobPosting?         @relation("JobPostingEmployerReviews", fields: [job_id], references: [id])
  dispute                  RecruiterReviewDispute?

  @@index([recruiter_user_id, status])
  @@index([has_dispute, dispute_status])
}

// ─────────────────────────────────────────────────────────────────────
// 58. Marketplace: RecruiterReport — formal complaints
// ─────────────────────────────────────────────────────────────────────
// SEPARATE from reviews. Reviews are public feedback. Reports are formal
// complaints that go to a superadmin review queue (private).
//
// Auto-actions: 3+ upheld reports in 30 days → 30-day suspension.
// 5+ upheld reports in 90 days → 90-day suspension. Any upheld
// 'rtr_violation' → automatic 14-day suspension.
model RecruiterReport {
  id                       Int       @id @default(autoincrement())
  recruiter_user_id        Int       // who is being reported
  reporter_user_id         Int?      // who filed the report (null = anonymous)
  reporter_role            String    // 'candidate' | 'employer' | 'recruiter_peer'

  // Report details
  reason_category          String    // 'misrepresentation' | 'harassment' | 'fee_dispute' | 'rtr_violation' | 'data_misuse' | 'other'
  description              String    @db.VarChar(2000)

  // Evidence
  evidence_urls            String?   @db.Text // JSON array

  // Status
  status                   String    @default("pending") // 'pending' | 'investigating' | 'resolved' | 'dismissed'
  priority                 String    @default("normal") // 'low' | 'normal' | 'high' | 'urgent'

  // Resolution
  admin_user_id           Int?
  resolution_notes         String?   @db.VarChar(2000)
  resolution_action       String?   // 'no_action' | 'warning' | 'temp_suspension' | 'perm_ban' | 'rtr_revoked'
  resolved_at             DateTime?

  // Linkage
  submission_id           Int?
  job_id                  Int?

  // Timestamps
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  // Relations
  recruiter                User                @relation("RecruiterReportsReceived", fields: [recruiter_user_id], references: [id])
  reporter                 User?               @relation("RecruiterReportsFiled", fields: [reporter_user_id], references: [id])
  admin                    User?               @relation("RecruiterReportsHandled", fields: [admin_user_id], references: [id])
  submission               CandidateSubmission? @relation(fields: [submission_id], references: [id])
  job                      JobPosting?         @relation(fields: [job_id], references: [id])

  @@index([recruiter_user_id, status])
  @@index([status, priority])
}

// ─────────────────────────────────────────────────────────────────────
// 59. Marketplace: RecruiterReviewDispute — recruiter's challenge to a negative review
// ─────────────────────────────────────────────────────────────────────
// Only available on reviews where any sub-score is ≤5/10. Recruiter
// clicks "Dispute Review" → fills out reason + explanation + evidence →
// goes into superadmin moderation queue.
//
// One dispute per review (unique constraint on review_id).
//
// Outcomes:
//   'review_kept'       — review stays as-is
//   'review_removed'    — review removed entirely
//   'review_annotated'  — review kept, but admin_annotation added publicly
//   'recruiter_warned' — review kept, recruiter gets a warning
model RecruiterReviewDispute {
  id                       Int       @id @default(autoincrement())
  review_id                Int
  recruiter_user_id        Int       // who is disputing (must be the reviewed recruiter)

  // Dispute grounds
  reason_category          String    // 'false_claim' | 'wrong_recruiter' | 'vindictive' | 'factually_incorrect' | 'policy_violation' | 'other'
  explanation              String    @db.VarChar(1000)

  // Evidence
  evidence_urls            String?   @db.Text // JSON array

  // Status
  status                   String    @default("pending")
    // 'pending' | 'investigating' | 'upheld' | 'removed' | 'annotated' | 'dismissed'
  admin_user_id            Int?
  admin_notes              String?   @db.VarChar(1000)
  resolution               String?   // 'review_kept' | 'review_removed' | 'review_annotated' | 'recruiter_warned'
  admin_annotation         String?   @db.VarChar(500)

  // Timestamps
  created_at               DateTime  @default(now())
  resolved_at              DateTime?

  // Relations
  review                   RecruiterReview @relation(fields: [review_id], references: [id], onDelete: Cascade)
  recruiter                User            @relation("ReviewDisputeRecruiter", fields: [recruiter_user_id], references: [id])
  admin                    User?           @relation("ReviewDisputeHandled", fields: [admin_user_id], references: [id])

  @@unique([review_id])
  @@index([status])
}
