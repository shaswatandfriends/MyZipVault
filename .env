# ─── Database (Supabase PostgreSQL) ─────────────────────────────────
# Replace with your Supabase connection string:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Auth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=myzipvault-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_KEY=myzipvault-encryption-key-32b!

# ─── Brevo (Transactional Email) ──────────────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=shaswatpandey0047@gmail.com

# ─── Supabase (Database + File Storage) ───────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key for server-side operations (storage admin access)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (Payments) ───────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Affinda (Resume Parsing) ────────────────────────────────────
# Get from: https://app.affinda.com/api-keys
AFFINDA_API_KEY=

# ─── Twilio (SMS Notifications) ──────────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
