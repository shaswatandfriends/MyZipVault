+      job_title: null,
+      specialty: null,
+      city: null,
+      state: null,
+      zip_code: null,
+      years_experience_total: null,
+      years_experience_specialty: null,
+      onboarding_completed_at: null,
+    },
+  });
+  console.log("reset done");
+}
+
+main().finally(() => prisma.$disconnect());
