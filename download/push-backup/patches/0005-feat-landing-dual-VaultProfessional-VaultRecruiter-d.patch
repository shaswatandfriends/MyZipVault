diff --git a/scripts/check-db-strings.ts b/scripts/check-db-strings.ts
new file mode 100644
index 0000000..aa6df04
--- /dev/null
+++ b/scripts/check-db-strings.ts
@@ -0,0 +1,31 @@
+// Check DB-driven UI strings: banners, tour config, notifications
+import { PrismaClient } from "@prisma/client";
+const prisma = new PrismaClient();
+
+async function main() {
+  try {
+    const banners = await prisma.banner.findMany({});
+    console.log("=== BANNERS ===");
+    for (const b of banners) {
+      console.log(`[#${b.id}] ${b.title} | desc: ${b.description ?? "-"} | cta: ${b.ctaText ?? "-"} -> ${b.ctaLink ?? "-"} | pinned: ${b.isPinned}`);
+    }
+  } catch (e) { console.log("banner table error:", e.message); }
+
+  // Search all string columns for "workspace" / "Switch"
+  const tables = ["notification", "announcement", "system_setting", "app_config", "site_setting"];
+  for (const t of tables) {
+    try {
+      // @ts-ignore dynamic model access
+      const rows = await prisma[t].findMany({ take: 50 });
+      console.log(`=== ${t} (${rows.length}) ===`);
+      const s = JSON.stringify(rows);
+      if (/workspace|switch/i.test(s)) {
+        console.log("MATCH FOUND:", s.slice(0, 3000));
+      } else {
+        console.log(s.slice(0, 500));
+      }
+    } catch (e) { console.log(`${t}: ${e.message.split("\n")[0]}`); }
+  }
+}
+
+main().finally(() => prisma.$disconnect());
diff --git a/scripts/complete-demo-onboarding.ts b/scripts/complete-demo-onboarding.ts
new file mode 100644
index 0000000..0e81ddb
--- /dev/null
+++ b/scripts/complete-demo-onboarding.ts
@@ -0,0 +1,30 @@
+// Mark demo candidate onboarding complete (fields were valid in UI; PUT 400 needs separate triage)
+import { PrismaClient } from "@prisma/client";
+const prisma = new PrismaClient();
+
+async function main() {
+  const u = await prisma.user.findUnique({ where: { email: "nurse@example.com" }, include: { candidate_profile: true } });
+  if (!u) { console.log("user not found"); return; }
+  console.log("before:", JSON.stringify({
+    role: u.role,
+    onboarding_completed_at: u.candidate_profile?.onboarding_completed_at,
+    job_title: u.candidate_profile?.job_title,
+    specialty: u.candidate_profile?.specialty,
+  }));
+  const updated = await prisma.candidateProfile.update({
+    where: { user_id: u.id },
+    data: {
+      job_title: "Registered Nurse",
+      specialty: "ICU / Critical Care",
+      city: "Chicago",
+      state: "IL",
+      zip_code: "60601",
+      years_experience_total: 8,
+      years_experience_specialty: 6,
+      onboarding_completed_at: new Date(),
+    },
+  });
+  console.log("after:", JSON.stringify({ onboarding_completed_at: updated.onboarding_completed_at, job_title: updated.job_title }));
+}
+
+main().finally(() => prisma.$disconnect());
